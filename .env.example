# Copy this file to `.env` and fill in real values. Never commit `.env`.

# ---- General ---------------------------------------------------------
ENVIRONMENT=production
DEBUG=false
TIMEZONE=UTC

# ---- Security ----------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-string

# ---- Database ------------------------------------------------------------
# SQLite (default, zero setup):
DATABASE_URL=sqlite+aiosqlite:///./data/guildos.db
# PostgreSQL (uncomment and fill in to migrate later):
# DATABASE_URL=postgresql+asyncpg://guildos:password@postgres:5432/guildos

# ---- Discord -------------------------------------------------------------
DISCORD_BOT_TOKEN=your-bot-token-here
DISCORD_GUILD_ID=123456789012345678
DISCORD_APPLICATION_CHANNEL_ID=123456789012345678
DISCORD_STAFF_CHANNEL_ID=123456789012345678
DISCORD_REPORT_CHANNEL_ID=123456789012345678
DISCORD_OWNER_DM_USER_ID=123456789012345678

# ---- OpenAI --------------------------------------------------------------
OPENAI_API_KEY=sk-your-key-here
OPENAI_MODEL=gpt-4o-mini

# ---- CORS (comma-separated origins allowed to hit the API) ---------------
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# ---- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
LOG_DIR=./logs
